---
import Image from "astronaut-cms/Image.astro";
import type { ComponentProps } from "@/cms.config";

type Props = ComponentProps["Figure"];

const { src, alt, caption } = Astro.props;
---

<figure class="figure">
  <Image src={src} alt={alt} width={1200} height={720} />
  {caption && <figcaption>{caption}</figcaption>}
</figure>
