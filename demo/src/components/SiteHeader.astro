---
const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/" ? path === "/" : path.startsWith(href);

const links = [
  { href: "/", label: "Home" },
  { href: "/blog", label: "Journal" },
  { href: "/about", label: "Studio" },
];
---

<header class="site-header">
  <div class="wrap site-header__inner">
    <a class="brand" href="/">
      <svg viewBox="0 0 32 32" fill="none" aria-hidden="true">
        <circle cx="16" cy="16" r="15" stroke="var(--ink)" stroke-width="1.5" />
        <path d="M2 20c6-9 22-9 28 0" stroke="var(--accent)" stroke-width="1.5" stroke-linecap="round" />
        <circle cx="16" cy="16" r="2.6" fill="var(--accent)" />
      </svg>
      Meridian
    </a>
    <nav class="nav" aria-label="Primary">
      {
        links.map((link) => (
          <a href={link.href} aria-current={isActive(link.href) ? "page" : undefined}>
            {link.label}
          </a>
        ))
      }
      <a class="btn btn-primary nav__cta" href="/admin">Open CMS</a>
    </nav>
  </div>
</header>
