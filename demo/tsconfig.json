{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"],
      "@client/*": ["../src/client/*"],
      "@shared/*": ["../src/shared/*"],
      "@assets/*": ["../assets/*"],
      "astronaut-cms": ["../src/integration/index.ts"],
      "astronaut-cms/config": ["../src/config.ts"],
      "astronaut-cms/assets": ["../src/assets/index.ts"]
    }
  }
}
