{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"],
      "@client/*": ["../src/client/*"],
      "@shared/*": ["../src/shared/*"],
      "@integration/*": ["../src/integration/*"],
      "@stubs/*": ["../src/stubs/*"],
      "astronaut-cms": ["../src/integration/index.ts"],
      "astronaut-cms/config": ["../src/config.ts"]
    }
  }
}
