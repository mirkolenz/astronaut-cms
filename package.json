{
  "name": "astronaut-cms",
  "version": "0.0.0",
  "description": "A Git-native headless CMS built as an Astro integration.",
  "keywords": [
    "astro",
    "astro-integration",
    "cms",
    "headless-cms",
    "git",
    "mdx",
    "zod"
  ],
  "homepage": "https://mirkolenz.github.io/astronaut-cms/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mirkolenz/astronaut-cms.git"
  },
  "workspaces": [
    "docs",
    "demo"
  ],
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/integration/index.d.ts",
      "source": "./src/integration/index.ts",
      "default": "./dist/integration.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "source": "./src/config.ts",
      "default": "./dist/config.js"
    },
    "./admin.astro": {
      "source": "./src/astro/admin.astro",
      "default": "./dist/astro/admin.astro"
    },
    "./Image.astro": {
      "source": "./src/astro/Image.astro",
      "default": "./dist/astro/Image.astro"
    },
    "./assets": {
      "types": "./dist/assets/index.d.ts",
      "source": "./src/assets/index.ts",
      "default": "./dist/assets.js"
    },
    "./ai-endpoint": {
      "types": "./dist/ai/endpoint.d.ts",
      "source": "./src/ai/endpoint.ts",
      "default": "./dist/ai-endpoint.js"
    },
    "./client": {
      "source": "./src/client/index.tsx",
      "default": "./dist/client.js"
    },
    "./internal": {
      "types": "./dist/internal/index.d.ts",
      "source": "./src/internal/index.ts",
      "default": "./dist/internal.js"
    },
    "./styles.css": {
      "source": "./src/astro/styles.css",
      "default": "./dist/astro/styles.css"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc",
    "test": "vitest run",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3",
    "@ai-sdk/react": "^4",
    "@gitbeaker/rest": "^43",
    "@mdxeditor/editor": "^4",
    "@octokit/rest": "^22",
    "@streamdown/cjk": "^1",
    "@streamdown/code": "^1",
    "@streamdown/math": "^1",
    "@streamdown/mermaid": "^1",
    "@tailwindcss/typography": "^0.5",
    "@tailwindcss/vite": "^4",
    "@tanstack/react-query": "^5",
    "@tanstack/react-router": "^1",
    "ai": "^7",
    "class-variance-authority": "^0.7",
    "clsx": "^2",
    "cmdk": "^1",
    "es-module-lexer": "^2",
    "i18next": "^26",
    "jiti": "^2",
    "lucide-react": "^1",
    "mammoth": "^1",
    "mdast-util-from-markdown": "^2",
    "mdast-util-mdx-jsx": "^3",
    "micromark-extension-mdx-jsx": "^3",
    "nanoid": "^6",
    "openid-client": "^6",
    "pathe": "^2",
    "radix-ui": "^1",
    "react-i18next": "^17",
    "shiki": "^4",
    "smol-toml": "^1",
    "sonner": "^2",
    "streamdown": "^2",
    "tailwind-merge": "^3",
    "tailwind-scrollbar-hide": "^4",
    "tailwindcss": "^4",
    "unpdf": "^1",
    "use-stick-to-bottom": "^1",
    "yaml": "^2",
    "zustand": "^5"
  },
  "devDependencies": {
    "@astrojs/react": "^6",
    "@fontsource-variable/geist": "^5",
    "@tanstack/router-plugin": "^1",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "astro": "^7",
    "react": "^19",
    "react-dom": "^19",
    "shadcn": "^4",
    "tw-animate-css": "^1",
    "typescript": "^6",
    "unplugin-dts": "^1",
    "vite": "^8",
    "vitest": "^4"
  },
  "peerDependencies": {
    "@astrojs/react": "^6",
    "astro": "^7",
    "react": "^19",
    "react-dom": "^19",
    "zod": "^4"
  },
  "overrides": {
    "@streamdown/code": {
      "shiki": "^4"
    }
  }
}
