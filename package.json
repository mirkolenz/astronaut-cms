{
  "name": "astronaut-cms",
  "version": "0.0.0",
  "description": "A Git-native headless CMS built as an Astro integration.",
  "keywords": [
    "astro",
    "astro-integration",
    "cms",
    "git",
    "headless-cms",
    "mdx",
    "zod"
  ],
  "homepage": "https://mirkolenz.github.io/astronaut-cms/",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mirkolenz/astronaut-cms.git"
  },
  "workspaces": [
    "docs",
    "demo"
  ],
  "files": [
    "dist",
    "src/astro/*.astro"
  ],
  "engines": {
    "node": ">=26"
  },
  "type": "module",
  "exports": {
    ".": "./dist/server/integration.js",
    "./config": "./dist/server/config.js",
    "./assets": "./dist/server/assets.js",
    "./content": "./dist/server/content.js",
    "./editor": "./dist/admin/editor.js",
    "./*.astro": "./src/astro/*.astro",
    "./styles.css": "./dist/styles/styles.css",
    "./bootstrap": "./dist/admin/bootstrap.js",
    "./internal": "./dist/server/internal.js",
    "./endpoint": "./dist/server/endpoint.js",
    "./server-local": "./dist/server/server-local.js"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "dev": "vite build --watch --no-emptyOutDir",
    "build": "vite build",
    "typecheck": "tsc",
    "test": "vitest run",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@types/mdast": "^4",
    "acorn": "^8",
    "aws4fetch": "^1",
    "fast-xml-parser": "^5",
    "jose": "^6",
    "mdast-util-from-markdown": "^2",
    "mdast-util-frontmatter": "^2",
    "mdast-util-mdx": "^3",
    "micromark-extension-frontmatter": "^2",
    "micromark-extension-mdxjs": "^3",
    "mime": "^4",
    "pathe": "^2",
    "smol-toml": "^1",
    "yaml": "^2"
  },
  "devDependencies": {
    "@ai-sdk/openai-compatible": "^3",
    "@ai-sdk/react": "^4",
    "@astrojs/react": "^6",
    "@codemirror/lang-css": "^6",
    "@codemirror/lang-html": "^6",
    "@codemirror/lang-javascript": "^6",
    "@codemirror/lang-json": "^6",
    "@codemirror/lang-markdown": "^6",
    "@codemirror/lang-yaml": "^6",
    "@codemirror/language": "^6",
    "@codemirror/legacy-modes": "^6",
    "@fontsource-variable/geist": "^5",
    "@mdxeditor/editor": "^4",
    "@streamdown/cjk": "^1",
    "@streamdown/code": "^1",
    "@tailwindcss/typography": "^0.5",
    "@tailwindcss/vite": "^4",
    "@tanstack/react-query": "^5",
    "@tanstack/react-router": "^1",
    "@tanstack/router-plugin": "^1",
    "@types/estree": "^1",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "ai": "^7",
    "astro": "^7",
    "class-variance-authority": "^0.7",
    "cmdk": "^1",
    "cn": "^0.3",
    "i18next": "^26",
    "lexical": "^0.48",
    "lucide-react": "^1",
    "mammoth": "^1",
    "nanoid": "^6",
    "next-themes": "^0.4",
    "radix-ui": "^1",
    "react": "^19",
    "react-dom": "^19",
    "react-i18next": "^17",
    "rolldown-plugin-dts": "^0.28",
    "scule": "^1",
    "shadcn": "^4",
    "shiki": "^4",
    "sonner": "^2",
    "streamdown": "^2",
    "tailwind-scrollbar-hide": "^4",
    "tailwindcss": "^4",
    "tw-animate-css": "^1",
    "typescript": "^6",
    "unpdf": "^1",
    "use-stick-to-bottom": "^1",
    "vite": "^8",
    "vitest": "^5",
    "zod": "^4",
    "zustand": "^5"
  },
  "peerDependencies": {
    "@astrojs/react": "^6",
    "astro": "^7",
    "react": "^19",
    "react-dom": "^19",
    "vite": "^8",
    "zod": "^4"
  },
  "overrides": {
    "@streamdown/code": {
      "shiki": "^4"
    }
  }
}
