---
import { Image as AstroImage } from "astro:assets";
import { resolveImage } from "astronaut-cms/assets";
import type { ImageMetadata, LocalImageProps } from "astro";

type Props = Omit<LocalImageProps, "src"> & {
  src: string | ImageMetadata;
  /** Content file the `src` is relative to (e.g. `entry.filePath`). Only needed for relative paths. */
  base?: string;
};

const { src, base, ...rest } = Astro.props;
const resolved = typeof src === "string" ? await resolveImage(src, base) : src;

// A resolved string means the media library lives in an object store, so this is
// a remote image and astro needs its dimensions. `inferSize` reads them from the
// image itself, at build time for a prerendered page, so neither the schema nor
// the editor has to carry them. An explicit width and height still win.
const inferSize = rest.width == null || rest.height == null;
---

{
  typeof resolved === "string" ? (
    <AstroImage src={resolved} inferSize={inferSize} {...rest} />
  ) : (
    <AstroImage src={resolved} {...rest} />
  )
}
