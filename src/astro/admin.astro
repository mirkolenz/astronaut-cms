---
import "astronaut-cms/styles.css";
import config from "virtual:astronaut-cms/config";
import { HARDENING_HEADERS } from "astronaut-cms/internal";

// A shell. It reads no session and carries no configuration: the bootstrap it
// loads asks the server who is asking, and only then imports the admin. That is
// what keeps the session cookie scoped to the API alone, since a page that had
// to read the cookie would need it scoped wide enough to reach this path, which
// means sending it with every request for the site's own pages.
//
// An anonymous visitor therefore gets this markup, the stylesheet and a
// bootstrap of a few hundred bytes. A session that lapses with the tab open
// lands here too: the API answers 401, the admin reloads, and the bootstrap
// reveals the sign-in panel below.

// The admin holds no credential, so a script that got in here can act as the
// editor while the tab is open but has nothing to send anywhere: every provider
// call is made by the server, and `connect-src 'self'` is the whole of it.
// `script-src 'self'` with no inline scripts is what carries the weight, by
// keeping injected markup from becoming script in the first place.
//
// The exceptions are the two places bytes deliberately do not pass through this
// deployment: a presigned upload, which goes browser-to-store, and an assistant
// whose editors bring their own key, which goes browser-to-gateway. Both origins
// have to be reachable or the browser refuses the request before sending it, and
// both are configuration this page cannot hold back, since a policy has to be in
// place before any script runs.

// The only inline script here is the dev-only Fast Refresh preamble below. A
// nonce admits that element and nothing an injection could write, which
// `'unsafe-inline'` would not, and it is minted per response so it cannot be
// replayed.
const nonce = import.meta.env.DEV ? crypto.randomUUID() : null;

const connectSrc = ["'self'"];

if (config.mediaBackend.type === "remote" && config.mediaBackend.storeOrigin) {
  connectSrc.push(config.mediaBackend.storeOrigin);
}

// Named as an origin rather than the full base, which is all a policy can say —
// and all it needs to, since the key only ever travels to this one host.
if (config.ai?.byok) connectSrc.push(new URL(config.ai.byok.baseUrl).origin);

const csp = [
  "default-src 'none'",
  `script-src 'self'${nonce ? ` 'nonce-${nonce}'` : ""}`,
  "style-src 'self' 'unsafe-inline'",
  "img-src 'self' data: blob: https:",
  "font-src 'self' data:",
  `connect-src ${connectSrc.join(" ")}`,
  "worker-src 'self' blob:",
  "frame-src 'none'",
  "frame-ancestors 'none'",
  "base-uri 'none'",
  // Sign-in is a link to the CMS's own route, which then redirects to the
  // provider, so nothing here ever posts off-origin.
  "form-action 'self'",
].join("; ");

// The CMS needs an SSR adapter, so this page always renders on demand and the
// policy always reaches the browser as a header — which is what lets it carry
// `frame-ancestors`, something a meta policy cannot.
for (const [name, value] of Object.entries({
  ...HARDENING_HEADERS,
  "content-security-policy": csp,
  // Admits `document.modelContext` while WebMCP is an origin trial. It is a
  // public, origin-bound token, and the API it unlocks exposes nothing the
  // editor could not already do in this tab.
  ...(config.webmcp?.originTrialToken && { "origin-trial": config.webmcp.originTrialToken }),
  // For the handful of agents that still read only this one.
  "x-frame-options": "DENY",
  // The page is the same for everyone, but it carries a per-response nonce in
  // dev and a policy that has to match what is served, so nothing may keep it.
  "cache-control": "private, no-store",
})) {
  Astro.response.headers.set(name, value);
}

// The admin mounts React from an external module script (see body) rather than an
// Astro island, so a production page ships no inline scripts at all and runs
// under the strict `script-src 'self'` CSP above. The trade-off: Astro's React
// integration only injects the Fast Refresh preamble on island pages, so in dev
// we install it ourselves. It is dev-only, production builds carry no Fast Refresh
// transform, so no preamble is needed and the CSP stays inline-script free.
//
// Copied verbatim from @vitejs/plugin-react's `preambleCode`, the same string
// @astrojs/react injects via injectScript("before-hydration", ...), with its
// `__BASE__` placeholder resolved to `/` rather than the configured `base`. Vite
// serves the refresh runtime at the base-less `/@react-refresh` in dev (and the
// transform appends imports to that exact path), so prefixing `import.meta.env.BASE_URL`
// would 404 under a non-root base. @astrojs/react hardcodes `/` for the same reason.
// Keep in sync with the installed version at node_modules/@vitejs/plugin-react/dist/index.js:
// the Fast Refresh transform throws unless `window.$RefreshReg$` is defined, which this
// preamble provides.
const fastRefreshPreamble = `import { injectIntoGlobalHook } from "/@react-refresh";
injectIntoGlobalHook(window);
window.$RefreshReg$ = () => {};
window.$RefreshSig$ = () => (type) => type;`;
---

<!-- The shell states only what it needs before the probe answers, and the
     admin's language is not that: the bootstrap sets it from the config. -->
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    {nonce && <script is:inline type="module" nonce={nonce} set:html={fastRefreshPreamble} />}
    <title>Astronaut CMS</title>
    <meta name="robots" content="noindex, nofollow" />
  </head>
  <body>
    <div id="astronaut-cms-root"></div>
    <!-- The whole of the anonymous admin, rendered here rather than built in
         script: the shell already emits HTML, so the sign-in screen costs no
         second rendering path and no escaping of the provider's message. Hidden
         until the bootstrap knows there is no session. -->
    <main id="astronaut-cms-signin" hidden class="grid min-h-screen place-items-center p-4">
      <div class="text-center">
        <h1 class="text-lg font-semibold">Astronaut CMS</h1>
        <p hidden class="mx-auto mt-2 max-w-md text-sm text-destructive"></p>
        <a
          href=""
          class="mt-4 inline-block rounded-md bg-primary px-4 py-2 text-primary-foreground no-underline"
          >Sign in</a
        >
      </div>
    </main>
    <script>
      import "astronaut-cms/bootstrap";
    </script>
  </body>
</html>
