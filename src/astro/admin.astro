---
import "astronaut-cms/styles.css";
import config from "virtual:astronaut-cms/config";
import { HARDENING_HEADERS } from "astronaut-cms/internal";
import { adminState, signInPage } from "astronaut-cms/endpoint";

// Nothing here is worth rendering without a session, so the session is settled
// before anything is. An anonymous request gets a sign-in link and no more: not
// the admin bundle, not the CMS config it carries (bucket origin, preview URL,
// model list), not any of the client dependencies. That is the largest
// unauthenticated surface the CMS has, and this is what removes it.
//
// A session that lapses with the tab open lands here too: the API answers 401,
// the admin reloads, and this renders the sign-in page.
const state = await adminState(Astro);

// Returned rather than branched in the template below: Astro hoists a `<script>`
// whatever encloses it, so a conditional there would still ship the bundle.
if (!state.signedIn) return signInPage(state, config.locale);

// The admin holds no credential: the repository session is a cookie the browser
// cannot read, and every provider call is made by the server. So this policy no
// longer has to allow a connection to github.com or to an object store, and
// `connect-src 'self'` is the whole of it — a script that got in here can act as
// the editor while the tab is open, but it has nothing to send anywhere.
//
// `script-src 'self'` with no inline scripts is still what carries the weight:
// it keeps injected markup from becoming script in the first place.
//
// A presigned upload is the one exception: the bytes go browser-to-store, so
// that store's origin has to be reachable or the browser refuses the request
// before it is sent.
const connectSrc = ["'self'"];

if (config.mediaBackend.type === "remote" && config.mediaBackend.storeOrigin) {
  connectSrc.push(config.mediaBackend.storeOrigin);
}

const csp = [
  "default-src 'none'",
  "script-src 'self'",
  "style-src 'self' 'unsafe-inline'",
  "img-src 'self' data: blob: https:",
  "font-src 'self' data:",
  `connect-src ${connectSrc.join(" ")}`,
  "worker-src 'self' blob:",
  "frame-src 'none'",
  "frame-ancestors 'none'",
  "base-uri 'none'",
  // Sign-in is a link to the CMS's own route, which then redirects to the
  // provider, so nothing here ever posts off-origin.
  "form-action 'self'",
].join("; ");

// The CMS needs an SSR adapter, so this page always renders on demand and the
// policy always reaches the browser as a header — which is what lets it carry
// `frame-ancestors`, something a meta policy cannot.
for (const [name, value] of Object.entries({
  ...HARDENING_HEADERS,
  "content-security-policy": csp,
  // For the handful of agents that still read only this one.
  "x-frame-options": "DENY",
  // What this page is depends on the caller's cookie, so no cache may keep it.
  "cache-control": "private, no-store",
})) {
  Astro.response.headers.set(name, value);
}

// The admin mounts React from an external module script (see body) rather than an
// Astro island, so the page ships no inline scripts and runs under the strict
// `script-src 'self'` CSP above without hashes. The trade-off: Astro's React
// integration only injects the Fast Refresh preamble on island pages, so in dev
// we install it ourselves. It is dev-only, production builds carry no Fast Refresh
// transform, so no preamble is needed and the CSP stays inline-script free.
//
// Copied verbatim from @vitejs/plugin-react's `preambleCode`, the same string
// @astrojs/react injects via injectScript("before-hydration", ...), with its
// `__BASE__` placeholder resolved to `/` rather than the configured `base`. Vite
// serves the refresh runtime at the base-less `/@react-refresh` in dev (and the
// transform appends imports to that exact path), so prefixing `import.meta.env.BASE_URL`
// would 404 under a non-root base. @astrojs/react hardcodes `/` for the same reason.
// Keep in sync with the installed version at node_modules/@vitejs/plugin-react/dist/index.js:
// the Fast Refresh transform throws unless `window.$RefreshReg$` is defined, which this
// preamble provides.
const fastRefreshPreamble = `import { injectIntoGlobalHook } from "/@react-refresh";
injectIntoGlobalHook(window);
window.$RefreshReg$ = () => {};
window.$RefreshSig$ = () => (type) => type;`;
---

<html lang={config.locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    {import.meta.env.DEV && <script is:inline type="module" set:html={fastRefreshPreamble} />}
    <title>Astronaut CMS</title>
    <meta name="robots" content="noindex, nofollow" />
  </head>
  <body>
    <div id="astronaut-cms-root"></div>
    <script>
      import { mount } from "astronaut-cms/client";

      const root = document.getElementById("astronaut-cms-root");
      if (root) mount(root);
    </script>
  </body>
</html>
