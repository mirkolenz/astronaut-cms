---
import { getImage } from "astro:assets";
import { resolveFile, resolveImage } from "astronaut-cms/assets";
import type { ImageMetadata, ImageOutputFormat } from "astro";
import type { HTMLAttributes } from "astro/types";

type Props = Omit<HTMLAttributes<"video">, "src" | "poster"> & {
  /** A `file()` value naming the video. */
  src: string;
  /** An `image()` value or an imported image, shown until the video plays. */
  poster?: string | ImageMetadata;
  /** Width the poster is optimized to, its own when unset. */
  posterWidth?: number;
  /** Format the poster is encoded in, webp like astro's `<Image>` when unset. */
  posterFormat?: ImageOutputFormat;
  /** Content file the paths are relative to (e.g. `entry.filePath`). Only needed for relative paths. */
  base?: string;
};

const { src, poster, posterWidth, posterFormat = "webp", base, ...rest } = Astro.props;
const [url, image] = await Promise.all([
  resolveFile(src, base),
  typeof poster === "string" ? resolveImage(poster, base) : poster,
]);

// The poster is the only part of a video astro can optimize, and it carries the
// video's proportions, so its dimensions also keep the box from jumping. They
// come off the result: reading them off the source would mark the original as
// referenced and keep it in the build output.
const still =
  image &&
  (await getImage({
    width: posterWidth,
    format: posterFormat,
    ...(typeof image === "string" ? { src: image, inferSize: true } : { src: image }),
  }));
---

<video
  src={url}
  poster={still?.src}
  width={still?.attributes.width}
  height={still?.attributes.height}
  {...rest}><slot /></video>
