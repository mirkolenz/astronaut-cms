{
  "ignorePatterns": [
    "src/**/*.gen.ts",
    "src/client/components/ui/**",
    "src/client/hooks/use-highlighted-code.ts",
    "src/client/hooks/use-mobile.ts",
    "src/client/lib/highlighter.tsx"
  ],
  "overrides": [
    {
      "files": ["src/**"],
      "excludeFiles": ["src/client/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/client/**"],
                "message": "Only the admin bundle may import admin code, the server and the integration never run it."
              }
            ]
          }
        ]
      }
    }
  ]
}
